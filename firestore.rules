rules_version = '2';

// 육삼레벨업 Firestore 보안 규칙
// Firebase 콘솔 → Firestore Database → 규칙(Rules) 탭에 이 내용을 그대로 붙여 넣고 [게시]를 눌러요.
// (README의 "보안 규칙 적용 순서"를 먼저 읽어 주세요)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isTeacher() {
      return signedIn() && request.auth.token.email == 'teacher@ourclass.kr';
    }
    // 홈페이지 문이 닫혀 있는지 (선생님 설정 → 🚪 홈페이지 문 열기·닫기)
    // 닫혀 있으면 학생은 아무것도 저장(쓰기)할 수 없어요. 새로고침하지 않은 옛날 화면도 마찬가지예요.
    // (읽기까지 막으면 학생 요청마다 이 문서를 한 번 더 읽어서 하루 읽기 한도를 빨리 써요. 그래서 쓰기에만 걸어요.)
    function siteClosed() {
      return exists(/databases/$(database)/documents/config/closure)
        && get(/databases/$(database)/documents/config/closure).data.closed == true;
    }
    function canUse() {
      return isTeacher() || !siteClosed();
    }

    // 사이트 설정·선생님 아이디 등: 로그인 화면에서도 읽어야 해서 누구나 읽기 가능
    // (선생님 비밀번호는 더 이상 여기 저장하지 않아요)
    // closure(홈페이지 문 열기·닫기)는 선생님만 바꿀 수 있어요.
    match /config/{docId} {
      allow read: if true;
      allow write: if signedIn() && (docId != 'closure' || isTeacher()) && canUse();
    }

    // 학생 비밀번호 기록: 선생님만 읽을 수 있어요.
    // 학생은 자기 비밀번호를 바꿀 때 자기 기록만 쓸 수 있어요(읽기는 못 해요).
    match /studentSecrets/{studentId} {
      allow read: if isTeacher();
      allow write: if isTeacher() || (signedIn() && request.auth.uid == studentId && canUse());
    }

    // 그 밖의 모든 기록: 로그인한 사람만 (지금까지와 같은 범위)
    match /{collectionName}/{docId} {
      allow read: if signedIn()
        && collectionName != 'studentSecrets'
        && collectionName != 'config';
      allow write: if signedIn()
        && collectionName != 'studentSecrets'
        && collectionName != 'config'
        && canUse();
    }
  }
}
